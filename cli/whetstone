#!/usr/bin/env bash
# whetstone — runtime-agnostic CLI entry point (noun-verb, zero deps, pure bash).
#
# Wraps the scriptable plumbing so Whetstone is usable outside an agent runtime
# (CI, scripting, muscle memory). The one thing it does NOT do is run `distill`:
# mining a session + layering L1-L4 is agent work — the CLI tells you to invoke
# the /distill skill instead of pretending to do it.
#
#   whetstone <command> [args...]
#
# Install: symlink onto PATH, e.g.  ln -s "$PWD/cli/whetstone" ~/.local/bin/whetstone
# (or just call ./cli/whetstone). Paths are resolved relative to this file, so the
# whole repo can be cloned anywhere.

ORIG_PATH="$PATH"
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PYTHONNOUSERSITE=1
# Resolve the file itself, not the link it was called through: installed as a symlink
# on PATH, dirname of the link would be ~/.local/bin and every bin/ lookup would miss.
# Loop rather than `readlink -f`, which older macOS does not have.
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$LINK_DIR/$SRC";; esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
WHETSTONE_VERSION="0.2.0"

usage() {
  cat <<EOF
whetstone $WHETSTONE_VERSION — distill dev sessions into portable Agent Skills

usage: whetstone <command> [args]

skill library (scriptable):
  pack [--src D] [--out F] [--only a,b]   package a skill library -> tarball + MANIFEST
  deploy <pack.tar.gz> [--dest D] [--force]  install a pack into a skills dir (collision-safe)
  deploy-selftest                         run the deploy selftest (a missing option value must not spin)
  promote <proposal> [--list] [--dry-run] [--force]
                                          apply an approved inbox/ proposal to the live library
  sync engram <skill> [--dry-run]         push a skill into engram (optional sink)

evidence discipline (the rules in extraction-framework, made executable):
  verify <pkg>... | --src D [--strict] [--json]
                                          check provenance, the mechanical confidence
                                          table, reproduction keys, layering and runtime
                                          neutrality in a skill package
  verify --explain                        what each check is — and what is left to humans
  verify-selftest                         run the verify selftest (fixtures, both directions)
  verify-mutation                         delete each check in turn; the selftest must go red

review decisions (raw material for the framework's own evolution — see spec/review-decisions.md):
  decision add --subject S --verdict V --reason R [--tag T --source C ...]
                                          record what the reviewer did to one proposal
  decision stats                          what the accumulated decisions point at
  decision list [-n N]                    recent records, incl. layer/confidence moves
  decision tags                           the starter tag vocabulary
  decision alias --from X --to Y --reason R
                                          fold two spellings of one meaning together
                                          (read-time only; stored lines never change)
  decision aliases                        which tags are folded into which
  decision report --entry E --ai-type T --ai-evidence V --ai-action A --ai-certainty C
                  --subject S --reason R [--source C --safety --blocking]
                                          step 1 of a conflict found while USING an entry:
                                          the AI's call, on file BEFORE you are asked; prints
                                          the id + fingerprint the card must carry
  decision resolve --conflict-id ID --verdict V --reason R [--final-type T]
                                          step 2: your answer (spec/use-time-conflicts.md)
  decision miss --entry E --final-type T --verdict V --subject S --reason R
                                          one the AI used without reporting — you found it
  decision-selftest                       run the decision selftest
  decision-mutation                       delete each decision check; the suite must go red

index hygiene (keep the selection menu clean as the library grows):
  lint [--src D] [--strict] [--json]      flag empty/overlapping/colliding descriptions, and
       [--listing F|-] [--menu-budget N]  whether the whole menu fits (--listing = the menu
       [--menu-reserve N]                 a runtime actually sent: which skills lost their
                                          descriptions)
  menu-snapshot [--session ID]            print the menu Claude Code last sent (for --listing):
                                            whetstone menu-snapshot | whetstone lint --listing -
  menu-snapshot --events [--session ID]   which skills, by name: every menu update ("N skill
                                          available") and every real load, in time order
                                          (default: this session, via $CLAUDE_CODE_SESSION_ID)
  lint-selftest                           run the lint selftest (both directions per check)
  lint-mutation                           break each menu check in turn; the selftest must go red
  index [--src D] [--out F]               generate a grouped INDEX.md catalog
  router <library-repo>                   same as: route catalog <library-repo>

routing (spec/routing.md; runtime-neutral, reads session events):
  find <what you are about to do>         which skills fit: name / description / body / messages
       [--src D] [--top N] [--json]       that led to them before; says so when none fits well
  route catalog <library-repo>            (re)generate the library's routing skill: the whole
                                          catalog behind one short menu entry; reads
                                          <repo>/skill-scopes.tsv; lint says when it is stale
  route events [--days N]                 this machine's sessions as neutral event lines
                                          (Claude Code adapter; other runtimes: adapters/)
  route learn --events F|-                messages that led to each skill -> the file find reads
  route usage --events F|-                skill x project table (once per session, decayed)
  route replay --events F|- [--sweep]     score find on past sessions in time order; checks
                                          itself (random must lose, a peek must win)
  route elsewhere --events F|- --project D  skills whose use sits in another project
  route plan --project D [--write]        Claude Code: set those to name-only in D's
                                          .claude/settings.local.json (merge; prints unless --write)
  route-selftest / route-mutation         both directions per rule / break each rule in turn

capture (optional, runtime-specific):
  capture [--clean]                       the Claude Code session journaler (see adapters/capture/)
  selftest                                run the capture hook selftest
  journal                                 list captured sessions

autoupdate (optional, multi-CLI update prompter — see autoupdate/README.md):
  autoupdate check                        report which watched repos are behind their remote
  autoupdate update                       pull --ff-only every behind repo (asks nothing, changes repos)
  autoupdate install|upgrade|uninstall    wire/unwire the session hooks (joins a sibling
                                          *-autoupdate install instead of double-hooking)
  autoupdate selftest                     run the autoupdate selftest (isolated fixtures)

agent-only:
  distill                                 (runs inside an agent runtime — see note below)

misc:
  version | help

distill is NOT a CLI op: mining the transcript + git diff and layering L1-L4 is
agent work. In your runtime invoke the /distill skill (or run SKILL.md Phase 0-5).
EOF
}

journal_cmd() {
  local J="$REPO_DIR/journal/sessions.jsonl"
  [ -s "$J" ] || { echo "no captured sessions yet ($J)"; return 0; }
  if command -v jq >/dev/null 2>&1; then
    jq -r '"\(.ts)  head=\(.head // "-")  Δ\(.changed // "-")  \(.cwd)"' "$J"
  else
    cat "$J"
  fi
}

sync_cmd() {
  local backend="${1:-}"; [ $# -gt 0 ] && shift
  case "$backend" in
    engram)   exec bash "$REPO_DIR/adapters/sync/engram.sh" "$@";;
    llm-wiki) echo "llm-wiki sync is doc-only for now — see adapters/sync/llm-wiki.md" >&2; exit 1;;
    *)        echo "usage: whetstone sync engram <skill> [--dry-run]" >&2; exit 2;;
  esac
}

autoupdate_cmd() {
  # autoupdate 是「不锁 PATH」的可分发组件(要用使用者环境的 git/jq/timeout,
  # 比如 homebrew 的 /opt/homebrew/bin)——恢复原始 PATH 再派发
  export PATH="$ORIG_PATH"
  local sub="${1:-check}"; [ $# -gt 0 ] && shift
  case "$sub" in
    check)                     exec bash "$REPO_DIR/autoupdate/hooks/check-update.sh" --report "$@";;
    update)                    exec bash "$REPO_DIR/autoupdate/bin/do-update.sh" "$@";;
    install|upgrade|uninstall) exec bash "$REPO_DIR/autoupdate/install.sh" "$sub" "$@";;
    selftest)                  exec bash "$REPO_DIR/autoupdate/selftest.sh" "$@";;
    *) echo "usage: whetstone autoupdate [check|update|install|upgrade|uninstall|selftest]" >&2; exit 2;;
  esac
}

router_cmd() {
  # the routing skill of one library repo, from the standard places (spec/routing.md §4 ③)
  local repo="${1:-}"
  [ -n "$repo" ] && [ -d "$repo/skills" ] || { echo "usage: whetstone router <library-repo> [index.py options]" >&2; exit 2; }
  shift
  command -v python3 >/dev/null 2>&1 || { echo "router needs python3" >&2; exit 3; }
  exec python3 "$REPO_DIR/bin/index.py" --router \
    --src "${WHETSTONE_SKILLS_DIR:-$HOME/.claude/skills}" --src "$repo/skills" \
    --scopes "$repo/skill-scopes.tsv" --out "$repo/skills/experience-router/SKILL.md" "$@"
}

route_cmd() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift
  command -v python3 >/dev/null 2>&1 || { echo "route needs python3" >&2; exit 3; }
  case "$sub" in
    catalog)                    router_cmd "$@";;
    events)                     exec python3 "$REPO_DIR/adapters/menu/claude-code.py" --export-events "$@";;
    usage|learn|replay|find|elsewhere) exec python3 "$REPO_DIR/bin/route.py" "$sub" "$@";;
    plan)                       exec python3 "$REPO_DIR/adapters/levers/claude-code.py" "$@";;
    *) echo "usage: whetstone route [catalog|events|learn|usage|replay|find|elsewhere|plan]" >&2; exit 2;;
  esac
}

distill_msg() {
  cat >&2 <<EOF
distill runs inside an agent runtime, not the CLI.
  - In Claude Code (or any skill-aware runtime): invoke the /distill skill.
  - Or open SKILL.md and run Phase 0-5 by hand.
The CLI handles the deterministic steps around it: promote / pack / deploy / sync.
EOF
  exit 2
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  pack)              exec bash "$REPO_DIR/bin/pack.sh" "$@";;
  deploy)            exec bash "$REPO_DIR/bin/deploy.sh" "$@";;
  deploy-selftest)   exec bash "$REPO_DIR/bin/deploy_selftest.sh" "$@";;
  promote)           exec bash "$REPO_DIR/bin/promote.sh" "$@";;
  verify)            command -v python3 >/dev/null 2>&1 || { echo "verify needs python3" >&2; exit 3; }; exec python3 "$REPO_DIR/bin/verify.py" "$@";;
  verify-selftest)   exec bash "$REPO_DIR/bin/verify_selftest.sh" "$@";;
  verify-mutation)   exec bash "$REPO_DIR/bin/verify_mutation_test.sh" "$@";;
  decision)          command -v python3 >/dev/null 2>&1 || { echo "decision needs python3" >&2; exit 3; }; exec python3 "$REPO_DIR/bin/decision.py" "$@";;
  decision-selftest) exec bash "$REPO_DIR/bin/decision_selftest.sh" "$@";;
  decision-mutation) exec bash "$REPO_DIR/bin/decision_mutation_test.sh" "$@";;
  lint)              command -v python3 >/dev/null 2>&1 || { echo "lint needs python3" >&2; exit 3; }; exec python3 "$REPO_DIR/bin/lint.py" "$@";;
  menu-snapshot)     command -v python3 >/dev/null 2>&1 || { echo "menu-snapshot needs python3" >&2; exit 3; }; exec python3 "$REPO_DIR/adapters/menu/claude-code.py" "$@";;
  lint-selftest)     exec bash "$REPO_DIR/bin/lint_selftest.sh" "$@";;
  lint-mutation)     exec bash "$REPO_DIR/bin/lint_mutation_test.sh" "$@";;
  index)             command -v python3 >/dev/null 2>&1 || { echo "index needs python3" >&2; exit 3; }; exec python3 "$REPO_DIR/bin/index.py" "$@";;
  router)            router_cmd "$@";;
  route)             route_cmd "$@";;
  find)              command -v python3 >/dev/null 2>&1 || { echo "find needs python3" >&2; exit 3; }; exec python3 "$REPO_DIR/bin/route.py" find "$@";;
  route-selftest)    exec bash "$REPO_DIR/bin/route_selftest.sh" "$@";;
  route-mutation)    exec bash "$REPO_DIR/bin/route_mutation_test.sh" "$@";;
  capture)           exec bash "$REPO_DIR/adapters/capture/claude-code.sh" "$@";;
  selftest)          exec bash "$REPO_DIR/adapters/capture/selftest.sh" "$@";;
  journal)           journal_cmd "$@";;
  sync)              sync_cmd "$@";;
  autoupdate)        autoupdate_cmd "$@";;
  distill)           distill_msg;;
  -V|--version|version) echo "whetstone $WHETSTONE_VERSION";;
  -h|--help|help|"") usage;;
  *) echo "unknown command: $cmd" >&2; echo "run 'whetstone help'" >&2; exit 2;;
esac
